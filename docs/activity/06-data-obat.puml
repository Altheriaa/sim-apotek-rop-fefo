@startuml 06-data-obat
title Activity Diagram Kelola Data Obat
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #333333
skinparam ArrowColor #333333
skinparam SwimlaneBorderColor #333333
skinparam NoteBackgroundColor #F5F5F5
|Pengguna|
start
:Membuka menu Data Obat;
|Sistem|
:Menampilkan daftar obat;
|Pengguna|
switch (Aksi?)
case (Tambah)
  :Membuka form tambah obat;
  |Sistem|
  :Menampilkan form dengan kode obat otomatis;
  |Pengguna|
  :Mengisi data obat dan parameter ROP;
  |Sistem|
  if (Input valid dan kode unik?) then (ya)
    :Menyimpan data obat;
    :Menampilkan pesan berhasil;
  else (tidak)
    :Menampilkan pesan kesalahan;
  endif
case (Ubah)
  |Pengguna|
  :Memilih obat dan membuka form edit;
  :Mengubah data;
  |Sistem|
  if (Input valid?) then (ya)
    :Memperbarui data obat;
    :Menampilkan pesan berhasil;
  else (tidak)
    :Menampilkan pesan kesalahan;
  endif
case (Hapus)
  |Pengguna|
  :Memilih obat dan konfirmasi hapus;
  |Sistem|
  :Menghapus data obat;
  :Menampilkan pesan berhasil;
case (Lihat detail)
  |Pengguna|
  :Memilih obat;
  |Sistem|
  :Menampilkan detail obat dan\ndaftar batch (urut ED);
endswitch
stop
@enduml
