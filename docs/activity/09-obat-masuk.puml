@startuml 09-obat-masuk
title Activity Diagram Obat Masuk
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #333333
skinparam ArrowColor #333333
skinparam SwimlaneBorderColor #333333
skinparam NoteBackgroundColor #F5F5F5
|Pengguna|
start
:Membuka menu Obat Masuk;
|Sistem|
:Menampilkan daftar batch obat masuk\n(hasil penerimaan pesanan);
|Pengguna|
if (Mencari atau memfilter?) then (ya)
  :Mengisi kata kunci, rentang tanggal,\natau status kadaluwarsa;
  |Sistem|
  :Menyaring data batch;
  :Menampilkan hasil;
endif
|Pengguna|
if (Melihat detail batch?) then (ya)
  :Memilih batch;
  |Sistem|
  :Menampilkan detail batch;
endif
stop
@enduml
