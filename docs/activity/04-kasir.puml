@startuml 04-kasir
title Activity Diagram Kasir (Penjualan)
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #333333
skinparam ArrowColor #333333
skinparam SwimlaneBorderColor #333333
skinparam NoteBackgroundColor #F5F5F5
|Pengguna|
start
:Membuka menu Kasir;
|Sistem|
:Menampilkan daftar obat dan stok rak;
|Pengguna|
:Memilih obat dan jumlah ke keranjang;
:Mengisi nama pembeli dan nominal bayar;
:Menekan tombol proses transaksi;
|Sistem|
if (Nominal bayar >= total harga?) then (ya)
  if (Stok rak semua item cukup?) then (ya)
    :Membuat nomor transaksi;
    :Mengurangi stok rak dari batch\ned terdekat (FEFO);
    :Menyimpan transaksi dan detail penjualan;
    :Menghitung ulang stok total terhadap ROP;
    if (Stok <= ROP dinamis?) then (ya)
      :Mengirim notifikasi WhatsApp ke admin;
      :Membuat draft pesanan ke supplier;
    endif
    if (Stok rak <= minimum rak?) then (ya)
      :Membuat notifikasi restock rak;
    endif
    :Menampilkan struk penjualan;
    |Pengguna|
    :Mencetak struk;
  else (tidak)
    |Sistem|
    :Membatalkan transaksi;
    :Menampilkan pesan stok rak tidak cukup;
  endif
else (tidak)
  :Menampilkan pesan nominal bayar kurang;
endif
stop
@enduml
