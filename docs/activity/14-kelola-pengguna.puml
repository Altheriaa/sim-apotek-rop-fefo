@startuml 14-kelola-pengguna
title Activity Diagram Kelola Pengguna
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #333333
skinparam ArrowColor #333333
skinparam SwimlaneBorderColor #333333
skinparam NoteBackgroundColor #F5F5F5
|Pengguna|
start
:Membuka menu Kelola Pengguna;
|Sistem|
:Menampilkan daftar pengguna;
|Pengguna|
switch (Aksi?)
case (Tambah)
  :Mengisi nama, email, username,\npassword, dan peran;
  |Sistem|
  if (Input valid, email dan\nusername unik?) then (ya)
    :Menyimpan pengguna (password di-hash);
    :Menampilkan pesan berhasil;
  else (tidak)
    :Menampilkan pesan kesalahan;
  endif
case (Ubah)
  |Pengguna|
  :Mengubah data pengguna;
  |Sistem|
  if (Input valid?) then (ya)
    if (Mengubah peran akun sendiri?) then (ya)
      :Menolak dan menampilkan pesan;
    else (tidak)
      :Memperbarui data pengguna;
      :Menampilkan pesan berhasil;
    endif
  else (tidak)
    :Menampilkan pesan kesalahan;
  endif
case (Hapus)
  |Pengguna|
  :Memilih pengguna dan konfirmasi hapus;
  |Sistem|
  if (Akun yang dihapus milik sendiri?) then (ya)
    :Menolak dan menampilkan pesan;
  else (tidak)
    :Menghapus pengguna;
    :Menampilkan pesan berhasil;
  endif
endswitch
stop
@enduml
