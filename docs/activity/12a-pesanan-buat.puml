@startuml 12a-pesanan-buat
title Activity Diagram Membuat Pesanan (ROP)
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #333333
skinparam ArrowColor #333333
skinparam SwimlaneBorderColor #333333
|Pengguna|
start
:Membuka menu Data Pesanan;
|Sistem|
:Menampilkan daftar pesanan\n(termasuk draft otomatis dari ROP);
|Pengguna|
:Membuka form pesanan baru;
:Memilih obat, jumlah, dan tanggal pesan;
:Menekan tombol simpan;
|Sistem|
if (Semua obat punya supplier?) then (ya)
  :Mengelompokkan item per supplier;
  :Menyimpan pesanan berstatus draft;
  :Menampilkan detail pesanan;
else (tidak)
  :Menampilkan pesan supplier belum ditentukan;
endif
stop
@enduml
