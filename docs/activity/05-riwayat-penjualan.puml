@startuml 05-riwayat-penjualan
title Activity Diagram Riwayat Penjualan
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #333333
skinparam ArrowColor #333333
skinparam SwimlaneBorderColor #333333
skinparam NoteBackgroundColor #F5F5F5
|Pengguna|
start
:Membuka menu Riwayat Penjualan;
|Sistem|
:Menampilkan daftar transaksi terbaru;
|Pengguna|
if (Mencari atau memfilter tanggal?) then (ya)
  :Mengisi no. transaksi atau rentang tanggal;
  |Sistem|
  :Menyaring data transaksi;
  :Menampilkan hasil;
endif
|Pengguna|
if (Melihat detail transaksi?) then (ya)
  :Memilih salah satu transaksi;
  |Sistem|
  :Menampilkan detail item penjualan;
  |Pengguna|
  :Membuka atau mencetak struk;
  |Sistem|
  :Menampilkan struk;
endif
stop
@enduml
