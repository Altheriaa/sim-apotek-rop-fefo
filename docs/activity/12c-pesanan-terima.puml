@startuml 12c-pesanan-terima
title Activity Diagram Penerimaan Barang Pesanan
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #333333
skinparam ArrowColor #333333
skinparam SwimlaneBorderColor #333333
|Pengguna|
start
:Membuka detail pesanan;
:Menekan tombol terima barang;
|Sistem|
if (Status pesanan "dikirim"?) then (ya)
  |Pengguna|
  :Mengisi jumlah diterima, tanggal\nkadaluwarsa, dan harga beli;
  |Sistem|
  if (Input valid?) then (ya)
    :Membuat nomor batch otomatis;
    :Membuat batch baru di gudang;
    :Mengubah status pesanan menjadi selesai;
    :Menampilkan pesan berhasil;
  else (tidak)
    :Membatalkan proses;
    :Menampilkan pesan kesalahan;
  endif
else (tidak)
  :Menampilkan pesan status belum dikirim;
endif
stop
@enduml
