@startuml 07-data-supplier
title Activity Diagram Kelola Data Supplier
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #333333
skinparam ArrowColor #333333
skinparam SwimlaneBorderColor #333333
skinparam NoteBackgroundColor #F5F5F5
|Pengguna|
start
:Membuka menu Data Supplier;
|Sistem|
:Menampilkan daftar supplier;
|Pengguna|
switch (Aksi?)
case (Tambah)
  :Mengisi form supplier baru;
  |Sistem|
  if (Input valid?) then (ya)
    :Menyimpan data supplier;
    :Menampilkan pesan berhasil;
  else (tidak)
    :Menampilkan pesan kesalahan;
  endif
case (Ubah)
  |Pengguna|
  :Memilih supplier dan mengubah data;
  |Sistem|
  if (Input valid?) then (ya)
    :Memperbarui data supplier;
    :Menampilkan pesan berhasil;
  else (tidak)
    :Menampilkan pesan kesalahan;
  endif
case (Hapus)
  |Pengguna|
  :Memilih supplier dan konfirmasi hapus;
  |Sistem|
  :Menghapus data supplier;
  :Menampilkan pesan berhasil;
case (Lihat detail)
  |Pengguna|
  :Memilih supplier;
  |Sistem|
  :Menampilkan detail supplier;
endswitch
stop
@enduml
