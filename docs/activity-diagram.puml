@startuml activity-diagram-sistem-inventaris
title Activity Diagram Sistem Inventaris Apotek Tabah Farma (ROP & FEFO)
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #333333
skinparam ArrowColor #333333
skinparam SwimlaneBorderColor #333333
skinparam NoteBackgroundColor #F5F5F5

|Pengguna|
start
:Membuka halaman login;
:Mengisi username dan password;

|Sistem|
repeat
  :Memvalidasi kredensial;
backward:Menampilkan pesan login gagal;
repeat while (Kredensial valid?) is (tidak) not (ya)
:Menampilkan dashboard;

|Pengguna|
:Mengelola data obat dan supplier;

|Sistem|
:Memvalidasi dan menyimpan data master;

|Pengguna|
:Membuat pesanan (pilih obat dan jumlah);

|Sistem|
:Mengelompokkan item per supplier;
:Menyimpan pesanan berstatus draft;

|Pengguna|
:Mencetak surat pesanan (PDF);
:Memperbarui status pesanan\n(diproses, dikirim);
:Menerima barang, mengisi jumlah,\ntanggal kadaluwarsa, dan harga beli;

|Sistem|
:Membuat batch baru di gudang\ndengan nomor batch otomatis;
:Mengubah status pesanan menjadi selesai;

|Pengguna|
:Memilih obat dan jumlah box\nuntuk transfer ke rak;

|Sistem|
if (Stok gudang cukup?) then (ya)
  :Memindahkan stok ke rak dari batch\ned terdekat (FEFO);
  :Mencatat riwayat transfer;
else (tidak)
  :Menampilkan pesan stok gudang\ntidak mencukupi;
endif

|Pengguna|
:Memilih obat, jumlah, dan\nmengisi nominal pembayaran di kasir;

|Sistem|
if (Stok rak cukup?) then (ya)
  :Mengurangi stok rak dari batch\ned terdekat (FEFO);
  :Menyimpan transaksi penjualan;
  :Menghitung ulang stok total terhadap ROP;
  if (Stok <= ROP dinamis?) then (ya)
    :Mengirim notifikasi WhatsApp ke admin;
    :Membuat draft pesanan ke supplier;
  endif
  :Menampilkan struk penjualan;
else (tidak)
  :Menampilkan pesan stok rak\ntidak mencukupi;
endif

|Pengguna|
:Memilih batch, jumlah, dan alasan\npembuangan obat;

|Sistem|
if (Jumlah valid?) then (ya)
  :Mengurangi stok batch;
  :Mencatat obat keluar;
else (tidak)
  :Menampilkan pesan kesalahan;
endif

|Pengguna|
:Memilih jenis laporan dan periode;

|Sistem|
:Menampilkan data laporan;
:Membuat dokumen PDF laporan;

|Pengguna|
:Melakukan logout;

|Sistem|
:Mengakhiri sesi;
stop

note right
  Terjadwal setiap hari 07:00:
  sistem memeriksa ROP, stok rak,
  dan batch kadaluwarsa dalam
  6 bulan, lalu mengirim notifikasi.
end note
@enduml
